{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://page-apps.github.io/reading-atlas/schemas/catalog.schema.json",
  "title": "Reading Atlas canonical catalogue records",
  "description": "Portable record definitions used by the split books, authors, and topics source files.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "kind"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "kind": { "type": "string", "minLength": 1, "maxLength": 30 }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "reason"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
      }
    },
    "book": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "authorIds", "year", "status", "accent", "topicIds", "tags", "description", "notes", "links", "relatedBooks"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1, "maxLength": 180 },
        "subtitle": { "type": "string", "minLength": 1, "maxLength": 180 },
        "authorIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "year": { "type": "integer", "minimum": 1000, "maximum": 2200 },
        "status": { "enum": ["read", "reading", "queued"] },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "topicIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "relatedBooks": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "summary", "topicIds", "tags", "notes", "links", "relatedAuthors"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 160 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "topicIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 2000 } },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } },
        "relatedAuthors": { "type": "array", "items": { "$ref": "#/$defs/relationship" } }
      }
    },
    "topic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "description", "accent"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "description": { "type": "string", "minLength": 1, "maxLength": 500 },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    }
  }
}
